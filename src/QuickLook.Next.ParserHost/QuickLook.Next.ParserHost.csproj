<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- This transport/FFI host uses Win32 through Core, without WinRT projections. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>QuickLook.Next.ParserHost</AssemblyName>
    <RootNamespace>QuickLook.Next.ParserHost</RootNamespace>
    <QuickLookUsesNative>true</QuickLookUsesNative>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\QuickLook.Next.Core\QuickLook.Next.Core.csproj" />
    <ProjectReference Include="..\QuickLook.Next.Contracts\QuickLook.Next.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="QuickLook.Next.ParserHost.IntegrationTests" />
  </ItemGroup>
</Project>
