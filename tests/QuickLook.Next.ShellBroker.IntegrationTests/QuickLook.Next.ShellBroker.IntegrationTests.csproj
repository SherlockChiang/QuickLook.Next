<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IsPackable>false</IsPackable>
    <ShellBrokerOutput>$(MSBuildThisFileDirectory)..\..\src\QuickLook.Next.ShellBroker\bin\$(Configuration)\net10.0-windows10.0.19041.0\win-x64\</ShellBrokerOutput>
    <NativeDll>$(MSBuildThisFileDirectory)..\..\native\target\release\quicklook_next_native.dll</NativeDll>
    <IconFixture>$(MSBuildThisFileDirectory)..\..\src\QuickLook.Next.App\Assets\QuickLookNext.ico</IconFixture>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\QuickLook.Next.Core\QuickLook.Next.Core.csproj" />
    <ProjectReference Include="..\..\src\QuickLook.Next.ShellBroker\QuickLook.Next.ShellBroker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="StageShellBroker" AfterTargets="Build">
    <Error Condition="!Exists('$(NativeDll)')" Text="Build the native release DLL before integration tests: cargo build --release --locked --manifest-path native/quicklook_next_native/Cargo.toml" />
    <Error Condition="!Exists('$(IconFixture)')" Text="ShellBroker icon fixture is missing: $(IconFixture)" />
    <ItemGroup>
      <ShellBrokerFiles Include="$(ShellBrokerOutput)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ShellBrokerFiles)" DestinationFiles="@(ShellBrokerFiles->'$(OutDir)ShellBroker\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="$(NativeDll)" DestinationFolder="$(OutDir)ShellBroker" />
    <Copy SourceFiles="$(IconFixture)" DestinationFiles="$(OutDir)QuickLookNext.ico" />
  </Target>
</Project>
